# ---------------------------------------------------------------
# Editor, OS and Python noise
# ---------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
*.egg-info/

# ---------------------------------------------------------------
# Internal working notes - not for a public repository
# These discuss reviewer strategy, weaknesses and venue choice.
# ---------------------------------------------------------------
APPLY.md
*_CATATAN.md
*_HASIL.md
VERIFIKASI_*.md
CHANGES_*.md

# ---------------------------------------------------------------
# Manuscript sources and drafts
# The paper itself is not distributed through this repository.
# ---------------------------------------------------------------
*.doc
*.docx
*.pdf
~$*
arlrx_pipeline/

# ---------------------------------------------------------------
# Crash-recovery, dry-run and partial artefacts
# Keep the final result files; drop the interrupted ones.
# _dryrun_container/ holds stub outputs from a pipeline smoke test.
# They are NOT real results and must never reach a public repo whose
# purpose is reproducibility.
# ---------------------------------------------------------------
results/_dryrun_container/
*_dryrun*/
*_partial.json
*_partial.csv
*.tmp
*.log

# ---------------------------------------------------------------
# Large binaries
# Trained models are regenerated by the notebooks; they do not
# need to be versioned. Remove this block if you want them public.
# ---------------------------------------------------------------
models/
*.pkl
*.joblib
*.h5
*.keras
*.npz

# ---------------------------------------------------------------
# Scratch variants of the experiment modules.
# Verified with `git grep`: no notebook imports these. Publishing
# them next to arlrx.py would only raise the question of which file
# produced the results.
# ---------------------------------------------------------------
src/experiments/arlrx_a.py
src/experiments/arlrx_b.py
src/experiments/baselines1.py

# ---------------------------------------------------------------
# Stray or archived copies
# ---------------------------------------------------------------
/raw/
_to_delete/
_arsip*/
*.zip

# ---------------------------------------------------------------
# Secrets - never commit
# ---------------------------------------------------------------
.env
*.key
*.pem
credentials*.json

README_EXPERIMENTS.md
