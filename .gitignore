# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- uv ---
# uv.lock TIDAK di-ignore (biarkan ter-commit untuk reproducibility)
# tapi cache uv tidak perlu masuk repo
.uv-cache/

# --- Jupyter Notebook ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- Distribution / packaging ---
build/
dist/
*.egg-info/
.eggs/

# --- Environment variables / secrets ---
.env
.env.*
*.pem
*.key

# --- Data & model artifacts (umumnya besar, jangan di-commit) ---
data/raw/
data/interim/
data/processed/
*.csv
*.parquet
*.h5
*.hdf5
# *.pkl
*.pickle
*.npy
*.npz

# --- Model checkpoints / weights ---
checkpoints/
*.ckpt
*.pt
*.pth
*.onnx
saved_model/
logs/
runs/
mlruns/
wandb/

# --- OS / editor junk ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- Type checking / linting cache ---
.mypy_cache/
.ruff_cache/

*.log
# --- Result files: these ARE the paper's data-availability statement ---
# The global *.csv rule above keeps raw data out of the repository; the machine-
# readable experiment outputs must nevertheless be tracked, so re-include them.
!results/
!results/**/*.csv
!results/**/*.meta.json
!results/*.csv
!results/*.meta.json
# large prediction dumps stay out (*.npz is ignored globally)
results/*.npz
